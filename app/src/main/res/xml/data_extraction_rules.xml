<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 以降のバックアップと端末間の移行の対象から、すべて外す。
  選手の氏名（未成年を含む）を端末の外に出さない。バックアップはアプリの「書き出し」で行う（要件 F-1004）。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
